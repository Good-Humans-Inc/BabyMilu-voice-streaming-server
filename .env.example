# Conversations Supabase config for next_starter server-side read path
SUPABASE_URL=https://nartdhkcmwpzfecmsswf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_conversations_service_role_key
NEXT_STARTER_FETCH_TIMEOUT_SECONDS=0.2
NEXT_STARTER_DB_TIMEOUT_SECONDS=2.0
NEXT_STARTER_MAX_AGE_DAYS=7

# Device-bound miffy-dev task API. Google OIDC is minted from ADC/VM metadata;
# do not configure a shared task key or distribute a service-account JSON key.
BABYMILU_ALLOW_GCP_KEY_FILES=false
BABYMILU_TASK_API_BASE_URL=https://us-central1-composed-augury-469200-g6.cloudfunctions.net/tasks-api-miffy-dev
BABYMILU_TASK_API_TIMEOUT_SECONDS=4.0
